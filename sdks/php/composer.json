{
  "name": "yeetpost/yeetpost",
  "description": "PHP client for the yeetpost API. No runtime dependencies.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://yeetpost.com",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Yeetpost\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Yeetpost\\Tests\\": "tests/"
    }
  }
}
