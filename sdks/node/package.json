{
  "name": "yeetpost",
  "version": "2.6.0",
  "description": "Node client and CLI for the yeetpost API. No runtime dependencies.",
  "type": "module",
  "main": "./dist/yeetpost.js",
  "types": "./dist/yeetpost.d.ts",
  "bin": {
    "yeetpost": "./dist/cli.js"
